{
  "name": "runtime-card-game",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "php -S 127.0.0.1:8080 -t api scripts/api-router.php",
    "dev:all": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "test:pwa": "node scripts/test-pwa.mjs",
    "test:i18n": "node scripts/check-i18n.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test:php": "php tests/run.php",
    "test:api": "php tests/api-integration.php"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "basic-ftp": "^6.2.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
