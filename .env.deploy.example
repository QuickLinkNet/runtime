# Nach .env.deploy kopieren. Die Datei wird nicht versioniert.
FTP_HOST=web17.alfahosting-server.de
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
FTP_SECURE=false

# Das Deploy-Skript akzeptiert ausschließlich ein Ziel mit /runtime am Ende.
REMOTE_BASE_DIR=/html/apps/runtime
PUBLIC_APP_URL=https://www.red-it.org/apps/runtime/
SUBDOMAIN_URL=https://runtime.red-it.org/
